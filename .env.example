# Пример окружения. Настоящий .env в репозиторий не попадает (.gitignore),
# ключи не коммитятся никогда — это проверяет Stop-хук check-secrets.sh.
#
# Сервис работает и без ключа: ассистент тогда показывает расчёт с пометкой
# «без LLM». Ключ включает объяснения модели, но чисел она не считает.

# Адрес и порт сервера (раздаёт собранный SPA и /api/*).
HOST=127.0.0.1
PORT=8080
# Каталог собранного SPA; по умолчанию ./dist
# STATIC_DIR=dist

# --- Провайдер LLM -----------------------------------------------------------
# Разрешены только модели, доступные в РФ: Qwen, DeepSeek, GigaChat, YandexGPT
# (ответ организаторов 16.09.2026). Ключ и баланс — наши.
#
# LLM_ENDPOINT — полный URL метода chat completions, протокол OpenAI-совместимый.
# Адреса ниже взяты из документации провайдеров 17.09.2026, а не по памяти;
# точное имя модели сверяйте с их документацией в день запуска:
#   DeepSeek — https://api-docs.deepseek.com/ , база https://api.deepseek.com
#     LLM_ENDPOINT=https://api.deepseek.com/v1/chat/completions
#   Qwen (Alibaba Model Studio, режим совместимости с OpenAI):
#     международный   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#     материковый Китай https://dashscope.aliyuncs.com/compatible-mode/v1
#     LLM_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
#
#   DeepSeek через Yandex Cloud AI Studio (OpenAI-совместимый API, оплата из РФ;
#   проверено живым прогоном 19.09.2026, docs/verification/llm-live-2026-09-19.md):
#     LLM_ENDPOINT=https://llm.api.cloud.yandex.net/v1/chat/completions
#     LLM_MODEL=gpt://<folder_ID>/deepseek-v4-flash
#     LLM_TIMEOUT_MS=60000          # модель рассуждающая: ответ 20–40 с, 30 с бывает мало
#     LLM_MAX_OUTPUT_TOKENS=4000    # рассуждение съедает бюджет; с 800 ответ бывает пустым (D-206)
#
# GigaChat и YandexGPT говорят на собственном протоколе: этому клиенту нужен
# отдельный адаптер, его пока нет (ограничение записано в README).
# Имя провайдера видно снаружи в /api/health — только имя, без ключей и адресов.
LLM_PROVIDER=deepseek
LLM_ENDPOINT=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=ИМЯ_МОДЕЛИ_ИЗ_ДОКУМЕНТАЦИИ_ПРОВАЙДЕРА
LLM_API_KEY=ключ-провайдера-сюда-не-коммитить
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=800

# Предел обращений к ассистенту на процесс: защита баланса на демонстрации.
# Один разговорный обмен резервирует два слота (разбор намерения и выбор фактов).
ADVICE_RATE_LIMIT=30
ADVICE_RATE_WINDOW_MS=60000
