#!/usr/bin/env bash
# Без взятой задачи не пушим (D-299): ветка worktree-<N>-<тема>, задача #N открыта и
# назначена на меня. Подключается сам: `npm ci` выполняет `prepare` →
# git config core.hooksPath .githooks. Работает и для Codex, и для людей.
# Push только удаления ветки (уборка после merge, GIT.md) не проверяем: у всех
# обновлений в stdin локальный sha — нули.
refs="$(cat)"
if [ -n "$refs" ] && ! printf '%s\n' "$refs" | awk '$2 !~ /^0+$/ {found=1} END {exit !found}'; then
  exit 0
fi
script="$(git rev-parse --show-toplevel)/scripts/issues.sh"
if [ ! -f "$script" ]; then
  echo "[issues] в этой ветке нет scripts/issues.sh — влейте origin/main; работа без задачи запрещена (D-299)" >&2
  exit 1
fi
exec bash "$script" check .
